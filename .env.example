# Open-Law-Austria — Umgebungsvariablen
# Kopiere diese Datei nach .env und passe die Werte an.
# Die .env-Datei wird NICHT ins Repository eingecheckt (.gitignore).

# ─── Server ──────────────────────────────────────────────────────────────────
# Port, auf dem der Server lauscht (Standard: 5000)
PORT=5000

# Node-Umgebung: "development" oder "production"
NODE_ENV=development

# ─── Sicherheit ──────────────────────────────────────────────────────────────
# Optionaler Token zum Schutz der Admin-API-Routen (/api/admin/*).
# Wenn gesetzt: alle Admin-Requests müssen den Header
#   Authorization: Bearer <ADMIN_TOKEN>
# mitschicken.
#
# EMPFEHLUNG: Setzen, wenn die App im Netzwerk oder öffentlich erreichbar ist.
# Leer lassen für lokale Einzelplatz-Nutzung (Standard).
#
# ADMIN_TOKEN=dein-geheimes-token-hier

# ─── Datenbank ───────────────────────────────────────────────────────────────
# Pfad zur SQLite-Datenbank (Standard: data.db im Projektverzeichnis)
DB_PATH=./data/data.db
